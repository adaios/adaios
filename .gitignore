# ── Java ──
*.class
*.jar
*.war
*.nar
build/
target/
!gradle-wrapper.jar

# ── Gradle ──
.gradle/
*/build/

# ── IDE / Claude ──
.idea/
# .claude 排除本地设置，但共享可演进资产（skills/agents/commands）
# `**/` 前缀让规则匹配所有层级的 .claude（根 + 子项目）
**/.claude/*
!**/.claude/skills/
!**/.claude/skills/**
!**/.claude/agents/
!**/.claude/agents/**
!**/.claude/commands/
!**/.claude/commands/**
.obsidian/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
out/
bin/

# ── OS ──
.DS_Store
Thumbs.db

# ── Logs ──
*.log
logs/

# ── Env ──
.env
.env.local
.env.*.local
*.secret

# ── Temp ──
tmp/
temp/
*.bak

# ── Spring Boot ──
*.springBeans
*.pid
heapdump.*

# ── AdaIOS 个人隐私数据 ──
# 个人记忆、交易记录、持仓等隐私数据不提交
# 多用户架构预留（2026-08-02）：数据按用户分层 data/{userId}/，用通配忽略所有用户层
data/*/records/
data/*/memory/
data/*/trading/

# 任务数据（R2 记录↔任务派生，含私人待办，不提交）
# 2026-08-15 文档治理批：P1-3 补齐（此前 data/*/project/ 漏忽略，data/adai/project 曾误提交）
data/*/project/

# AI 交互日志含完整 prompt 全文（档案/记忆/持仓/用户原文），不提交
# 2026-08-12 deep 审核 P0 #226：新增落盘目录必须同步 .gitignore（B25 检查点）
data/*/ai-logs/

# identity 的示例配置文件选择性提交（见 data/identity/profile.sample.md）
# data/identity/ 下除 *.sample.md 外全部不提交（含真实用户偏好/头像等）
# 2026-08-12 deep 审核 #223：原只保护 profile.md 单文件，identity 下新非 sample 文件会进 git（K9）
data/*/identity/*
!data/*/identity/*.sample.md

# 索引文件可从 records 重建，不追踪
data/*/index/

# 数据迁移自动备份（data-backup-*.tar.gz，确认后可删）
data-backup-*.tar.gz

# 账号列表（系统级敏感配置，不提交；AccountFileRepository 首次启动自动 seed adai）
data/accounts/

# ── 后端测试残留数据 ──
services/adai-core/data/

# ── Flutter / Dart ──
.dart_tool/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
*.flutter_plugins
*.flutter_plugin_registrant
.flutter-plugins-dependencies
*.flutter_plugins
*.flutter_plugin_registrant
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.apk
*.aab
*.ipa
*.dSYM.zip
*.dSYM
