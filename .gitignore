# ── Java ──
*.class
*.jar
*.war
*.nar
build/
target/
!gradle-wrapper.jar

# ── Gradle ──
.gradle/
*/build/

# ── IDE / AI 工具本地目录 ──
.idea/
# 工具侧目录整目录忽略：技能注册是「本机状态」而非仓库资产，真相源在 .agents/
# 换机 / 新 clone 后重建：bash .agents/mechanism/scripts/ai-link-skills.sh（验证：bash .agents/mechanism/guards/ai-guard-tools.sh 的 T4）
.dsh/
.claude/
# ── 仓库内 worktree（并行开发线，2026-10-05 起）──
# 每条线一个目录、各自独立 index；机制与外挂见 .agents/rules/guides/worktree-workflow.md §五
.worktrees/
# ── .agents/ —— AI 上下文工程容器（2026-10-03 起；2026-10-04 二批改为 6 顶层）──
# 真相源（skills / roles / assets / process / guards / scripts / rfc / review / features / ledger …）**必须入库**；
# 只忽略「本机状态」与「出口」两类。⚠️ 规则必须**带前缀锚定**——写成 `skills/` 会连真相源一起忽略（pitfalls 二十三 记过这个坑）。
.agents/records/state/
# 旧路径（2026-10-04 六顶层重构前）——保留忽略防残留复活
.agents/state/
# 注意：gitignore 不支持行尾注释（`模式  # 注释` 会把注释当成模式的一部分）
.qoder/
.codex/
# `.agents/skills/` 是**出口位**（公约数阵营：Codex / Cursor / Gemini CLI / Copilot / OpenCode …），
# 由 ai-link-skills.sh 软链到真相源 .agents/toolkit/skills/（2026-10-05 恢复该出口时补的忽略规则）。
# ⚠️ 必须精确到 `.agents/skills/`——写成 `skills/` 会连真相源一起忽略（pitfalls 二十三 同型坑）。
.agents/skills/
# 预留：根 skills/ 出口（OpenClaw 等工具的项目级目录）—— **必须锚定仓库根**：
# 写成 `skills/` 会连真相源 `.agents/toolkit/skills/` 一起忽略（见 pitfalls 二十三）
/skills/
.obsidian/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
out/
bin/

