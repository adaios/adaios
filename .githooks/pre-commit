#!/usr/bin/env bash
# 提交前自动门禁（六层）：
#   0) 本批范围守卫 —— 暂存区是否越出「本批声明」（防并发会话 git add -A 混装）
#   0b) 隐私闸门 + 密钥扫描 —— **任何变更类型都查**（必须先于下方类型触发条件：.txt/.json/.env
#       这类非 md/java/dart/sh 文件否则会 exit 0 绕过；密钥进 git 历史不可逆）
#   1) guard-align —— 代码↔文档内容对齐（A1 端点 / A2 测试数）
#   2) guard-meta  —— frontmatter 结构（M1 断链 / M2 lines / M3 孤儿 / M4 正文路径）
#   2b) guard-feature —— 功能索引对齐（RFC 20261001 批 2）
#   2c) guard-skills  —— 技能包质量（官方 Agent Skills 规范：name / description / 五段 / 偏离在案）
#   3) guard.sh    —— 防 P0 复发（G1-G7）
#   4) T6 shell-lint —— shell 脚本健壮性（$VAR 紧跟非 ASCII → 非 UTF-8 locale 下 unbound）
# 由 git core.hooksPath 启用（.agents/scripts/setup-hooks.sh 配置，随 clone 重建）。
cd "$(git rev-parse --show-toplevel)"

# 暂存区清单。⚠️ unborn HEAD（git init 后首次提交）下 `--name-only HEAD` 会 rc=128 → 变量为空
# → 0/0b 层静默跳过（2026-10-01 对抗审查实测：含 sk- 的 .env 能直接入库成功）。故失败即退回不带 ref 的写法。
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  CHANGED=$(git diff --cached --name-only HEAD 2>/dev/null || true)
else
  CHANGED=$(git diff --cached --name-only 2>/dev/null || true)
fi

# 0) 本批范围守卫（REVIEW P2-审查3，2026-09-17）——「收尾禁 git add -A」此前**零机制**：
#    规范只写在 ship.md 里靠自觉，2026-09-13 实际发生过「另一会话的 -A 把本批 9 个文件卷走」，
#    2026-09-17 又一次（B1+B2/B5/B4 三批提交时，工作区始终躺着另一会话的 docs/rfc/ 改动）。
#    这里把它变成机械检查——两种模式：
#      · **声明了本批范围**（环境变量 ADAI_BATCH_PATHS="apps/adai-app,docs/review"，
#        或仓库根放一个 .adai-batch 文件每行一个前缀）→ 暂存区里有不匹配任何前缀的文件
#        = 越界 → **阻断**（这正是「显式列路径」的机械化）；
#      · **没声明** → 打印暂存区摘要（按顶层目录分组），至少让提交者**看见自己在提交什么**，
#        **不阻断**。
#    为什么默认不阻断：并非每次提交都值得声明（单人小改），硬拦只会把人逼去 --no-verify——
#    那比没有守卫更糟（ship.md 明确不提供绕过路径）。
STAGED_LIST="${CHANGED}"
if [ -n "$STAGED_LIST" ]; then
  BATCH_DECL="${ADAI_BATCH_PATHS:-}"
  if [ -z "$BATCH_DECL" ] && [ -f .adai-batch ]; then
    BATCH_DECL=$(tr '\n' ',' < .adai-batch)
  fi
  if [ -n "$BATCH_DECL" ]; then
    OUT_OF_SCOPE=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      matched=0
      IFS=',' read -ra PREFIXES <<< "$BATCH_DECL"
      for p in "${PREFIXES[@]}"; do
        p_trim=$(printf '%s' "$p" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
        [ -z "$p_trim" ] && continue
        case "$f" in
          "$p_trim"|"$p_trim"/*) matched=1; break ;;
        esac
      done
      [ "$matched" -eq 0 ] && OUT_OF_SCOPE="${OUT_OF_SCOPE}${f}
"
    done <<< "$STAGED_LIST"

    if [ -n "$OUT_OF_SCOPE" ]; then
      echo "❌ 本批范围守卫：以下文件**不在声明的本批范围内**（疑似另一会话的改动 / 误用 git add -A）："
      printf '%s' "$OUT_OF_SCOPE" | sed 's/^/    /'
      echo "   本批声明：ADAI_BATCH_PATHS=$BATCH_DECL"
      echo "   处理：git reset <越界文件>；若它确实属于本批，就把它加进声明再提交"
      exit 1
    fi
    echo "✅ 本批范围守卫：$(printf '%s\n' "$STAGED_LIST" | wc -l | tr -d ' ') 个文件全部在声明范围内"
  else
    echo "── 暂存区（未声明本批范围；设 ADAI_BATCH_PATHS 可开启机械校验）──"
    printf '%s\n' "$STAGED_LIST" | awk -F/ '{ c[$1]++ } END { for (k in c) printf "    %-24s %d 个\n", k, c[k] }' | sort
  fi
fi

# 0) 隐私闸门（B3 原则）——必须在类型触发条件之前：任何变更类型都查，
#    否则 .txt/.json 等数据文件（非 md/java/dart/sh）会在下方 exit 0 绕过（2026-08-23 对抗审计 P1-A1）
#    a) data/ 前缀禁止（只允许 *.sample.md 模板）
#    b) 新增文件（A 状态）gitignore 复核：被忽略仍尝试入库 = -f 强加或新数据目录漏 ignore——路径无关拦截
PRIVACY_VIOLATIONS=""
if echo "$CHANGED" | grep -qE '^data/'; then
  PRIVACY_VIOLATIONS=$(echo "$CHANGED" | grep -E '^data/' | grep -v '\.sample\.md$' || true)
fi
for f in $(git diff --cached --name-only --diff-filter=A 2>/dev/null); do
  if git check-ignore -q "$f"; then
    PRIVACY_VIOLATIONS="$PRIVACY_VIOLATIONS
$f"
  fi
done
if [ -n "$PRIVACY_VIOLATIONS" ]; then
  echo "❌ 隐私红线（B3）：个人数据禁止提交！"
  echo "$PRIVACY_VIOLATIONS" | sed 's/^/    /'
  echo "   修复：git reset <文件>（数据只留本地），确认 .gitignore 覆盖新子目录（git check-ignore 验证）"
  exit 1
fi

# 0b) 密钥扫描（2026-10-01 加）——与隐私闸门同处入口层：**必须同样先于类型触发条件**。
#     这是本项目唯一「出事不可逆」的口子：`.gitignore` 只防**将来**、不查**过去**；密钥一旦
#     进了历史，删文件也没用（要改历史 + 换密钥）。执行器 .agents/scripts/scan-secrets.py 只扫暂存区
#     **新增行**：高置信形态（sk- / 私钥块 / AKIA / ghp_ …）与敏感文件名（.env / *.p8 / *.jks /
#     id_rsa）硬拦，通用「API_KEY=长值」只 WARN——误报会把人逼去 --no-verify，那比没有守卫更糟
#     （ship.md 同款取舍）。⚠️ 位置教训：放在类型触发条件之后时，.txt/.json/.env 会在下方
#     `exit 0` 绕过——隐私闸门 2026-08-23 已踩过同一个坑（见上一段注释）。
if [ -n "${STAGED_LIST}" ]; then
  # 扫描器缺失时**跳过而非锁死**：本批恰好是「改钩子 + 新增脚本」，若只 add 钩子不带脚本，
  # fail-closed 会把整个仓库的提交能力锁死（2026-10-01 对抗审查 P1-3）。对照 guard-feature 同款防御。
  if [ ! -f .agents/scripts/scan-secrets.py ]; then
    echo "⚠️  密钥扫描器缺失（.agents/scripts/scan-secrets.py）——本层跳过。"
    echo "   修复：确认它随本批一起提交，或 git checkout -- .agents/scripts/scan-secrets.py"
  else
    python3 .agents/scripts/scan-secrets.py || { echo "❌ 密钥扫描未通过，提交已阻止（见上）。处置：git restore --staged <file>；确需提交就说明它为何不是密钥；若已推送过，必须换密钥。"; exit 1; }
  fi
fi

# 触发条件：任何 .md / .java / .dart / .sh / .bash 变更，或 .githooks/ 自身变更
# （docs-only 也要查结构；.githooks/ 无扩展名，漏了它会让「只改钩子」绕过全部检查）
if ! echo "$CHANGED" | grep -qE '\.(java|dart|md|sh|bash)$|^\.githooks/'; then
  exit 0
fi

echo "── pre-commit: 文档对齐 + 结构 + 防复发 + shell 健壮性 + 隐私检查 ──"

# 1) 内容对齐（端点/测试数）——仅代码/契约相关变更时跑
if echo "$CHANGED" | grep -qE '\.(java|dart)$|status\.md|api-spec\.md|feature-reference\.md'; then
  bash .agents/guards/guard-align.sh || { echo "❌ 文档内容未对齐，提交已阻止（见上）。修复指引：同步 api-spec.md / status.md。"; exit 1; }
fi

# 2) 结构对齐（frontmatter 图谱/lines/孤儿/正文路径）——任何 md 变更都跑
#    task-log「工程-hook」（2026-09-26 夜间批）修正：原实现先 `--fix`（回写的是**工作区**）
#    再跑检查——而提交内容取自**暂存区**。若被 fix 的文件已暂存旧内容，这次回写对本次提交
#    完全无效：钩子报绿、提交进去的却还是旧 lines（下次检查原样再报）。改成：
#    **先检暂存内容的漂移 → 不一致就阻断并给两步指引**，不替用户动暂存区
#    （仓库有并发会话，自动 git add 会把别人的改动卷进本批——2026-09-13 真实事故）。
if echo "$CHANGED" | grep -qE '\.(md|java|dart)$'; then
  if ! bash .agents/guards/guard-meta.sh >/dev/null 2>&1; then
    bash .agents/guards/guard-meta.sh --fix >/dev/null 2>&1   # 幂等回写工作区 lines
    echo "❌ frontmatter 结构未对齐，提交已阻止。已自动跑 guard-meta --fix 回写工作区。"
    echo "   注意：提交内容取自**暂存区**——请把本批涉及的 md 文件重新显式 git add 后再提交"
    echo "   （不自动 add 是为了不把并发会话的改动卷进本批，见 .agents/process/ship.md §7）。"
    echo "   剩余人工项：M1 图谱断链 / M3 孤儿文档（--fix 不处理这两类）。"
    exit 1
  fi
fi

# 2b) 功能索引对齐（guard-feature，RFC 20261001 批 2）——「功能主轴」是否真实
#     索引行字段/链接/状态枚举、卡内有没有被抄进实现细节、卡有没有超长、卡文件是否孤儿；
#     任何 md 变更都可能动到索引 / 卡 / RFC status，故与结构检查同触发条件
#     防御（对抗审查 A3，2026-10-01）：脚本或索引目录尚未落地时**跳过**，不阻断——
#     「环境未就绪」不等于「索引坏了」（否则部分克隆 / 只改了别的 md 的提交会被 127 拦死）
if [ -f .agents/guards/guard-feature.sh ] && [ -f docs/features/_index.md ] && echo "$CHANGED" | grep -qE '\.md$'; then
  FEAT_OUT=$(bash .agents/guards/guard-feature.sh 2>&1); FEAT_RC=$?
  if [ "$FEAT_RC" -ne 0 ]; then
    if echo "$FEAT_OUT" | grep -q 'FEATURE-GUARD:'; then
      echo "$FEAT_OUT"
      echo "❌ 功能索引未对齐，提交已阻止（见上）。修复指引：改 docs/features/_index.md 或对应插件的意图卡（规格见 RFC 20261001 §3.1）。"
    else
      echo "❌ 功能索引**守卫脚本自身出错**（不是索引的问题，需排查 guard-feature.sh）："
      echo "$FEAT_OUT" | tail -5 | sed 's/^/    /'
    fi
    exit 1
  fi
fi

# 2c) 技能包质量（guard-skills，RFC 20261003-skill-conformance）—— 官方规范硬约束是否满足
#     S3 name 字符集/长度/与目录名一致 · S4 description 长度 · S5 五段结构 · S7 偏离在案
#     （S8 哈希锁**刻意不做**：单人 + git 已覆盖版本控制，判定见该 RFC §四）
#     触发条件同 2b（技能 / 审查官 / 规范都是 md）；防御同 2b：脚本未落地时跳过，不阻断
if [ -f .agents/guards/guard-skills.sh ] && echo "$CHANGED" | grep -qE '\.md$'; then
  SKILL_OUT=$(bash .agents/guards/guard-skills.sh 2>&1); SKILL_RC=$?
  if [ "$SKILL_RC" -ne 0 ]; then
    if echo "$SKILL_OUT" | grep -q 'SKILL-GUARD:'; then
      echo "$SKILL_OUT"
      echo "❌ 技能包不合官方规范，提交已阻止（见上）。修复指引：改 name/description/五段结构；结构性偏离须写进 .agents/assets/skills-spec.md 第六节。"
    else
      echo "❌ 技能包守卫**脚本自身出错**（不是技能的问题，需排查 guard-skills.sh）："
      echo "$SKILL_OUT" | tail -5 | sed 's/^/    /'
    fi
    exit 1
  fi
fi

# 3) 防 P0 复发（G1-G7）——代码变更时跑
# 2026-08-23 P2-A3 修正：不再吞输出——PASS 静默、HIT 显示摘要、脚本自坏（exit≠0 且无 HIT）单独报错可区分
if echo "$CHANGED" | grep -qE '\.(java|dart)$'; then
  GUARD_OUT=$(bash docs/review/guard.sh 2>&1); GUARD_RC=$?
  if [ "$GUARD_RC" -ne 0 ]; then
    if echo "$GUARD_OUT" | grep -qiE 'HIT|PASS: [0-9]+ HIT'; then
      echo "⚠️ 守护检查有 HIT（防 P0 复发），请确认非复发后修复（不提供 --no-verify 绕过，见 .agents/process/ship.md）："
      echo "$GUARD_OUT" | grep -iE 'HIT|PASS' | sed 's/^/    /'
      exit 1
    else
      echo "❌ 守护脚本自身出错（非 HIT，需排查 guard.sh）："
      echo "$GUARD_OUT" | tail -5 | sed 's/^/    /'
      exit 1
    fi
  fi
fi

# 4) shell 脚本健壮性（$VAR 紧跟非 ASCII → 非 UTF-8 locale 下字节被并进变量名，set -u 中止）
#    根因与复发信号见 .agents/assets/pitfalls.md 十五；执行器 .agents/scripts/lint-shell-vars.py
#    仅 shell 变更时跑（执行器自身扫描全部 git 跟踪的 shell 脚本，27 个，很快）
if echo "$CHANGED" | grep -qE '\.(sh|bash)$|^\.githooks/'; then
  bash .agents/guards/guard-tools.sh --shell-lint || { echo "❌ shell 脚本健壮性检查未通过，提交已阻止。修复指引：把 \$VAR 写成 \${VAR}——凡中文文案里嵌 shell 变量，一律加花括号。"; exit 1; }
fi

bash .agents/guards/guard-sediment.sh >/dev/null 2>&1 || true   # 软提示：沉淀/出表/登记检查（不硬拦）
echo "✅ 文档对齐 + 结构 + 功能索引 + 技能包质量 + 防复发 + shell 健壮性检查通过（隐私闸门 + 密钥扫描在入口层，见上方输出）"
